#!/usr/bin/env bash
# chattr stub: records `chattr +i`/`chattr -i` invocations to
# $GUARD_STUB_LOG (one line per call) so install/uninstall tests can
# assert the immutable flag was toggled for the right <path>.real.
# When $GUARD_LSATTR_DB is set, also persists the flag state (one
# "path|flags" line per file) so the lsattr stub can answer the
# installer's own post-checks. Exits 0 by default. Set
# GUARD_CHATTR_FAIL=1 to simulate a host whose filesystem rejects
# immutability (install-lock-runtime should then exit 3).
log="${GUARD_STUB_LOG:-}"
if [ -n "$log" ]; then
    printf 'chattr %s\n' "$*" >> "$log"
fi
if [ "${GUARD_CHATTR_FAIL:-0}" = "1" ]; then
    echo "chattr: Operation not supported (stub)" >&2
    exit 1
fi
db="${GUARD_LSATTR_DB:-}"
if [ -n "$db" ] && [ $# -eq 2 ]; then
    mode="$1"
    path="$2"
    flags="-------------"
    case "$mode" in
        +i) flags="-i-----------" ;;
        -i) flags="-------------" ;;
    esac
    tmp="$db.tmp.$$"
    if [ -f "$db" ]; then
        awk -F'|' -v p="$path" '$1 != p' "$db" > "$tmp"
    else
        : > "$tmp"
    fi
    printf '%s|%s\n' "$path" "$flags" >> "$tmp"
    mv "$tmp" "$db"
fi
exit 0
