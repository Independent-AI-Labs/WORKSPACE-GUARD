#!/usr/bin/env bash
# dpkg-divert stub: mimics the three subcommands install/uninstall-
# lock-runtime rely on. State persists to $GUARD_DIVERT_DB (one entry
# per line, "path<TAB>target"); absent entries behave as undiverted.
#   dpkg-divert --truename <path>        -> <target> when diverted
#   dpkg-divert --list [<path>]          -> stdout line(s) for diverted
#                                           (all entries when no path)
#   dpkg-divert --add [--rename] --divert <target> <path>  -> record
#   dpkg-divert --remove [--rename] <path> -> unrecord
db="${GUARD_DIVERT_DB:-}"
nulldev="${DEVNULL:-/dev/null}"

# Look up the stored divert target for a path (empty when undiverted).
target_of() {
    [ -n "$db" ] && [ -f "$db" ] || return 0
    awk -F'\t' -v p="$1" '$1==p {print $2; exit}' "$db" 2>"$nulldev"
}

case "$1" in
    --truename)
        path="${2:-}"
        target="$(target_of "$path")"
        if [ -n "$target" ]; then
            printf '%s\n' "$target"
        else
            printf '%s\n' "$path"
        fi
        ;;
    --list)
        path="${2:-}"
        if [ -n "$db" ] && [ -f "$db" ]; then
            while IFS=$'\t' read -r p target; do
                [ -n "$p" ] || continue
                [ -z "$path" ] || [ "$p" = "$path" ] || continue
                printf 'local diversion of %s to %s\n' "$p" "$target"
            done < "$db"
        fi
        ;;
    --add)
        # args: --add [--rename] --divert <target> <path>
        path="${!#}"
        divert="" rename=0
        prev=""
        for a in "$@"; do
            if [ "$prev" = "--divert" ]; then divert="$a"; fi
            [ "$a" = "--rename" ] && rename=1
            prev="$a"
        done
        if [ -n "$db" ]; then
            mkdir -p "$(dirname "$db")"
            if [ -z "$(target_of "$path")" ]; then
                printf '%s\t%s\n' "$path" "$divert" >> "$db"
            else
                tmp="$(mktemp)"
                awk -F'\t' -v p="$path" -v t="$divert" \
                    'BEGIN{OFS="\t"} $1==p{$2=t} {print}' "$db" > "$tmp" 2>"$nulldev"
                mv "$tmp" "$db"
            fi
        fi
        # --rename: move $path to the divert target
        if [ "$rename" -eq 1 ] && [ -f "$path" ] && [ -n "$divert" ]; then
            mv "$path" "$divert" 2>"$nulldev" || true
        fi
        ;;
    --remove)
        path="${!#}"
        rename=0
        for a in "$@"; do [ "$a" = "--rename" ] && rename=1; done
        target="$(target_of "$path")"
        if [ -n "$db" ] && [ -f "$db" ]; then
            tmp="$(mktemp)"
            awk -F'\t' -v p="$path" '$1!=p {print}' "$db" > "$tmp" 2>"$nulldev"
            mv "$tmp" "$db"
        fi
        # --rename: restore the divert target back to $path
        if [ "$rename" -eq 1 ] && [ -n "$target" ] && [ -f "$target" ]; then
            mv "$target" "$path" 2>"$nulldev" || true
        fi
        ;;
    *)
        echo "dpkg-divert stub: unrecognized args: $*" >&2
        exit 2
        ;;
esac
exit 0