#!/usr/bin/env bash
# exec-policy: exclusive-execution-posture lifecycle.
#
# Implements docs/specifications/SPEC-EXEC-POLICY.md section 9. Every lane
# has exactly one owner and the posture is fail-closed: the agent session
# starts only when all owners are verified, and no layer substitutes for
# another.
#
#   stage    (root) install/reconcile the loader, BPF object, AppArmor
#            profile, session gate, unit and drop-in; leave state unarmed.
#   enable   (root) verify every owner, run the denial canary, write the
#            readiness manifest, and set state=armed.
#   disable  (root) remove the readiness manifest and set state=unarmed;
#            the agent session then refuses to start.
#   check    (any) read-only report; NOT INSTALLED / NOT ARMED / OK /
#            DRIFTED.
#   unstage  (root) remove the staged artifacts; policy and state remain.
#
# Test hooks: WEP_ROOT prefixes absolute paths, WEP_ALLOW_NONROOT skips the
# euid gate, WEP_SYSTEMCTL / WEP_APPARMOR_PARSER override tool paths,
# WEP_CANARY runs a denial probe on enable, WEP_LOADER_SRC / WEP_BPF_OBJ_SRC
# override built artifacts.

set -uo pipefail

DEVNULL=/dev/null
WEP_ROOT="${WEP_ROOT:-}"
SELF="${BASH_SOURCE[0]}"
case "$SELF" in
    /proc/self/fd/*) SELF="${SHG_SCRIPT_PATH:-$SELF}" ;;
esac
SELF_DIR="$(cd "$(dirname "$SELF")" 2>"$DEVNULL" && pwd)"
REPO_ROOT="${WEP_REPO_ROOT:-$(cd "$SELF_DIR/.." 2>"$DEVNULL" && pwd)}"

ETC="$WEP_ROOT/etc/workspace-guard"
POLICY="$ETC/exec_allowlist.yaml"
STATE_FILE="$ETC/exec-policy-state"
READY="$WEP_ROOT/run/workspace-exec-policy/ready"
BPF_READY="$WEP_ROOT/run/workspace-exec-policy/bpf-ready"
LOADER="$WEP_ROOT/usr/local/bin/workspace-exec-policyd"
BPF_OBJ="$WEP_ROOT/usr/local/lib/workspace-guard/exec_policy.bpf.o"
GATE="$WEP_ROOT/usr/local/bin/workspace-exec-policy-session-gate"
APPARMOR="$WEP_ROOT/etc/apparmor.d/workspace-exec-policy"
UNIT="$WEP_ROOT/etc/systemd/system/workspace-exec-policyd.service"
DROPIN_DIR="$WEP_ROOT/etc/systemd/system/workspace-agent@.service.d"
DROPIN="$DROPIN_DIR/10-exec-policy.conf"
LSM_FILE="$WEP_ROOT/sys/kernel/security/lsm"
LOCKDOWN_FILE="$WEP_ROOT/sys/kernel/security/lockdown"
YAMA_FILE="$WEP_ROOT/proc/sys/kernel/yama/ptrace_scope"

LOADER_SRC="${WEP_LOADER_SRC:-$REPO_ROOT/target/release/workspace-exec-policyd}"
BPF_OBJ_SRC="${WEP_BPF_OBJ_SRC:-$REPO_ROOT/target/release/exec_policy.bpf.o}"
PROFILE_SRC="$REPO_ROOT/config/systemd/workspace-exec-policy.apparmor"
POLICY_SRC="$REPO_ROOT/config/exec_allowlist.yaml"
SYSTEMCTL="${WEP_SYSTEMCTL:-systemctl}"
APPARMOR_PARSER="${WEP_APPARMOR_PARSER:-apparmor_parser}"

# One owner per lane. Every line must be verified before arming.
OWNERS="exec=bpf fs=apparmor ptrace=yama kernel=lockdown caps=capability"

have() { command -v "$1" >"$DEVNULL" 2>&1; }

note() { echo "exec-policy: $*"; }
warn() { echo "WARN: $*" >&2; }

require_root() {
    if [ "$(id -u)" -ne 0 ] && [ -z "${WEP_ALLOW_NONROOT:-}" ]; then
        echo "ERROR: this target needs root: sudo make $1" >&2
        exit 1
    fi
}

state() {
    if [ -f "$STATE_FILE" ]; then
        tr -d '[:space:]' < "$STATE_FILE"
    else
        echo unarmed
    fi
}

bpf_active() {
    [ -r "$LSM_FILE" ] || return 1
    grep -qw bpf "$LSM_FILE"
}

installed() {
    [ -f "$LOADER" ] || return 1
    [ -f "$BPF_OBJ" ] || return 1
    [ -f "$GATE" ] || return 1
    [ -f "$APPARMOR" ] || return 1
    [ -f "$UNIT" ] || return 1
    return 0
}

apparmor_enforcing() {
    [ -f "$APPARMOR" ] || return 1
    ! grep -q 'flags=(complain)' "$APPARMOR"
}

missing_authority_artifacts() {
    [ -f "$LOADER_SRC" ] || return 0
    [ -f "$BPF_OBJ_SRC" ] || return 0
    return 1
}

# --- lane owners -----------------------------------------------------------

owner_exec() {
    bpf_active || return 1
    [ -f "$BPF_READY" ] || return 1
    return 0
}

owner_fs() {
    apparmor_enforcing
}

owner_ptrace() {
    local v
    v="$(cat "$YAMA_FILE" 2>"$DEVNULL")"
    [ -n "$v" ] || return 1
    [ "$v" -ge 2 ] 2>"$DEVNULL"
}

owner_kernel() {
    [ -r "$LOCKDOWN_FILE" ] || return 1
    grep -q '\[integrity\]\|\[confidentiality\]' "$LOCKDOWN_FILE"
}

owner_caps() {
    [ -f "$DROPIN" ] || return 1
    grep -q 'CapabilityBoundingSet=' "$DROPIN" || return 1
    grep -q 'NoNewPrivileges=no' "$DROPIN"
}

owners_ok() {
    local missing=""
    owner_exec   || missing="$missing exec=bpf"
    owner_fs     || missing="$missing fs=apparmor"
    owner_ptrace || missing="$missing ptrace=yama"
    owner_kernel || missing="$missing kernel=lockdown"
    owner_caps   || missing="$missing caps=capability"
    if [ -n "$missing" ]; then
        warn "owners not verified:$missing"
        return 1
    fi
    return 0
}

write_manifest() {
    mkdir -p "$(dirname "$READY")"
    : > "$READY"
    for owner in $OWNERS; do
        printf '%s\n' "$owner" >> "$READY"
    done
    chmod 0644 "$READY"
}

seed_help() {
    warn "allowlist policy missing: $POLICY_SRC"
    warn "seed it once through the secure editor (root), then re-run stage:"
    warn "  sudo make yaml-bootstrap FILE=config/exec_allowlist.yaml KEY=version VALUE=1"
    warn "  sudo make yaml-bootstrap FILE=config/exec_allowlist.yaml KEY=deny VALUE='{default: true}'"
    warn "  sudo make yaml-add FILE=config/exec_allowlist.yaml KEY=allow \\"
    warn "       FIELDS='path=/bin/bash;sha256=<hex>;allow_uid=1000;note=guarded shell'"
    warn "See docs/OPERATOR.md 'Exclusive execution posture' for the reviewed seed set."
}

install_one() {
    local src="$1" dst="$2" perm="$3"
    mkdir -p "$(dirname "$dst")"
    install -Dm "$perm" "$src" "$dst"
}

systemctl_do() {
    have "$SYSTEMCTL" || return 0
    "$SYSTEMCTL" "$@" >"$DEVNULL" 2>&1
}

stage() {
    require_root install-exec-policy

    install_one "$REPO_ROOT/scripts/exec-policy-session-gate" "$GATE" 0755
    install_one "$PROFILE_SRC" "$APPARMOR" 0644
    install_one "$REPO_ROOT/config/systemd/workspace-exec-policyd.service" "$UNIT" 0644
    install_one "$REPO_ROOT/config/systemd/workspace-exec-policy.conf" "$DROPIN" 0644
    mkdir -p "$ETC"
    if [ ! -f "$STATE_FILE" ]; then
        printf 'unarmed\n' > "$STATE_FILE"
        chmod 0644 "$STATE_FILE"
    fi

    if [ -f "$POLICY_SRC" ]; then
        install_one "$POLICY_SRC" "$POLICY" 0644
        note "allowlist policy installed ($POLICY)"
    else
        seed_help
    fi

    if missing_authority_artifacts; then
        warn "authority artifacts not built (run: make build-exec-policy); posture stays unarmed"
    else
        install_one "$LOADER_SRC" "$LOADER" 0755
        install_one "$BPF_OBJ_SRC" "$BPF_OBJ" 0644
        systemctl_do enable workspace-exec-policyd.service
    fi

    if have "$APPARMOR_PARSER" && [ -f "$APPARMOR" ]; then
        "$APPARMOR_PARSER" -r "$APPARMOR" >"$DEVNULL" 2>&1 \
            || warn "AppArmor profile load failed"
    fi
    systemctl_do daemon-reload
    note "staged (state=$(state)); the agent session stays closed until armed"
    note "arm with: sudo make enable-exec-policy CONFIRM=1"
}

enable() {
    require_root enable-exec-policy
    if [ "${CONFIRM:-}" != "1" ]; then
        echo "ERROR: refusing to arm without CONFIRM=1" >&2
        echo "  review the policy, then: sudo make enable-exec-policy CONFIRM=1" >&2
        exit 2
    fi
    if ! installed || [ ! -f "$POLICY" ]; then
        echo "ERROR: not staged (run: sudo make install-exec-policy)" >&2
        exit 1
    fi
    if ! owners_ok; then
        echo "ERROR: refusing to arm; every layer owner must be verified" >&2
        echo "  see SPEC-EXEC-POLICY section 3 for the owner of each lane" >&2
        exit 1
    fi

    if [ -n "${WEP_CANARY:-}" ]; then
        if ! "$WEP_CANARY" >"$DEVNULL" 2>&1; then
            echo "ERROR: denial canary failed; posture stays unarmed" >&2
            printf 'unarmed\n' > "$STATE_FILE"
            exit 1
        fi
        note "denial canary passed"
    else
        warn "WEP_CANARY unset: skipping the denial canary (kernel phase only)"
    fi

    write_manifest
    printf 'armed\n' > "$STATE_FILE"
    systemctl_do restart workspace-exec-policyd.service
    note "armed (all layer owners verified)"
}

disable() {
    require_root disable-exec-policy
    rm -f "$READY"
    printf 'unarmed\n' > "$STATE_FILE"
    note "unarmed: the agent session refuses to start until re-armed"
}

unstage() {
    require_root uninstall-exec-policy
    systemctl_do stop workspace-exec-policyd.service
    systemctl_do disable workspace-exec-policyd.service
    rm -f "$LOADER" "$BPF_OBJ" "$GATE" "$APPARMOR" "$UNIT" "$DROPIN" "$READY" "$BPF_READY"
    rmdir "$DROPIN_DIR" >"$DEVNULL" 2>&1
    systemctl_do daemon-reload
    note "unstaged (policy and state preserved)"
}

check() {
    if ! installed; then
        note "NOT INSTALLED"
        return 2
    fi
    if [ ! -f "$POLICY" ]; then
        warn "allowlist policy missing ($POLICY); posture cannot be armed"
    fi
    if [ "$(state)" != "armed" ]; then
        note "NOT ARMED"
        return 0
    fi
    if [ ! -f "$READY" ] || ! owners_ok; then
        note "DRIFTED (armed but a layer owner is not verified)"
        return 1
    fi
    note "OK (armed)"
    return 0
}

ACTION="${1:-}"
case "$ACTION" in
    stage)    stage ;;
    enable)   enable ;;
    disable)  disable ;;
    check)    check ;;
    unstage)  unstage ;;
    -h|--help|"")
        printf 'Usage: %s <stage|enable|disable|check|unstage>\n' "$0"
        [ -n "$ACTION" ] || exit 2
        ;;
    *)
        echo "ERROR: unknown action: $ACTION" >&2
        printf 'Usage: %s <stage|enable|disable|check|unstage>\n' "$0" >&2
        exit 2
        ;;
esac
