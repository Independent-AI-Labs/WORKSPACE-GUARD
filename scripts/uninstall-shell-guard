#!/usr/bin/env bash
# uninstall-shell-guard: root-only removal of workspace-shell-guard.
#
# Implements docs/specifications/SPEC-SHELL-GUARD.md section 12.2:
# relaxes +i on the sealed original, removes the dpkg diversion with
# --rename (atomically restoring the diverted shell over the guard path),
# removes the sealed tree and the apt hook, and verifies the restored
# shell. /bin/sh is restored the same way when it was covered. An older
# /bin/bash.real install is also restored.
#
# Must run from the trusted tier (scripts/guard-root-exec): the uninstall
# strips an immutable flag, which the guard refuses to scan for an
# untrusted body.
#
# Usage:
#   scripts/uninstall-shell-guard            # remove the guard (ROOT)
#   scripts/uninstall-shell-guard --dry-run  # report without changing
#   scripts/uninstall-shell-guard -h|--help
#
# Exit codes:
#   0  guard removed (or was not installed)
#   1  failure
#   2  not root or bad arguments
#
# Test hook: SHG_ROOT prefixes every absolute path (fixtures).

set -euo pipefail

DEVNULL=/dev/null
SHG_ROOT="${SHG_ROOT:-}"

DRY_RUN=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        -h|--help)
            sed -n '2,26p' "$0"
            exit 0
            ;;
        *)
            echo "ERROR: unknown argument: $1" >&2
            exit 2
            ;;
    esac
done

log()  { echo "==> $*"; }
die()  { echo "ERROR: $*" >&2; exit 1; }

is_trusted_tier() {
    local f="$1" d
    [ -f "$f" ] || return 1
    [ "$(stat -c %u "$f")" = "0" ] || return 1
    [ $((8#$(stat -c %a "$f") & 8#022)) -eq 0 ] || return 1
    d="$(dirname "$f")"
    while [ "$d" != "/" ]; do
        [ "$(stat -c %u "$d")" = "0" ] || return 1
        [ $((8#$(stat -c %a "$d") & 8#022)) -eq 0 ] || return 1
        d="$(dirname "$d")"
    done
    return 0
}

BASH_LINK="$SHG_ROOT/bin/bash"
BASH_PATH="$(readlink -f "$BASH_LINK" 2>"$DEVNULL")"
if [ -z "$BASH_PATH" ]; then
    BASH_PATH="$BASH_LINK"
fi
SEALED_DIR="$SHG_ROOT/usr/lib/workspace-guard/sealed"
SEALED_PKG_DIR="$SEALED_DIR/pkg"
REAL_PATH="$SEALED_DIR/bash"
DISTRIB_PATH="$SEALED_PKG_DIR/bash"
LEGACY_REAL="$SHG_ROOT/bin/bash.real"
LEGACY_DISTRIB="$BASH_PATH.distrib"
APT_HOOK="$SHG_ROOT/etc/apt/apt.conf.d/99workspace-guard-shell"
APT_CHECK="$SHG_ROOT/usr/lib/workspace-guard/apt-shell-check"

divert_target() {
    dpkg-divert --list "$BASH_PATH" 2>"$DEVNULL" \
        | sed -n 's/.*diversion of .* to \([^ ]*\).*/\1/p'
}

if [ "$DRY_RUN" -eq 0 ]; then
    if [ "$(id -u)" != "0" ] && [ -z "$SHG_ROOT" ]; then
        echo "ERROR: uninstall-shell-guard needs root: sudo make uninstall-shell-guard" >&2
        exit 2
    fi
    if [ -z "$SHG_ROOT" ] && [ "$(id -u)" = "0" ] && ! is_trusted_tier "$0"; then
        echo "ERROR: uninstall-shell-guard must run from the trusted tier; use: sudo make uninstall-shell-guard" >&2
        exit 2
    fi
fi

guard_present() {
    [ -f "$REAL_PATH" ] || [ -f "$DISTRIB_PATH" ] || [ -f "$LEGACY_REAL" ] \
        || getcap "$BASH_PATH" 2>"$DEVNULL" | grep -q 'cap_dac_override=ep'
}

if ! guard_present; then
    log "shell guard is not installed; nothing to do"
    exit 0
fi

if [ "$DRY_RUN" -eq 1 ]; then
    have_real=no
    have_divert=no
    [ -f "$REAL_PATH" ] && have_real=yes
    [ -n "$(divert_target)" ] && have_divert=yes
    log "dry-run: would remove guard from $BASH_PATH (real=$have_real, divert=$have_divert)"
    exit 0
fi

# 1. Relax the immutable flag on the sealed original.
if [ -f "$REAL_PATH" ]; then
    if lsattr -d "$REAL_PATH" 2>"$DEVNULL" | awk '{print $1}' | grep -q 'i'; then
        chattr -i "$REAL_PATH"
    fi
fi

# 2. Remove the diversion with --rename: the diverted shell moves back over
#    the guard path in a single rename. Fall back to the sealed (or older)
#    copy when the diversion is already gone (drift).
current="$(divert_target)"
if [ -n "$current" ]; then
    log "removing diversion (restores $current -> $BASH_PATH)"
    # dpkg-divert --rename refuses to overwrite a file that differs
    # from the diverted original; remove the guard binary first.
    rm -f "$BASH_PATH" || die "cannot remove guard binary at $BASH_PATH"
    dpkg-divert --remove --rename "$BASH_PATH"
    chmod 0755 "$BASH_PATH" || die "cannot restore mode on $BASH_PATH"
elif [ -f "$REAL_PATH" ]; then
    log "no diversion found; restoring $BASH_PATH from $REAL_PATH"
    rb="$BASH_PATH.restore.$$"
    cp "$REAL_PATH" "$rb"
    chown root:root "$rb"
    chmod 0755 "$rb"
    mv -T "$rb" "$BASH_PATH"
elif [ -f "$LEGACY_REAL" ]; then
    log "no diversion found; restoring $BASH_PATH from older $LEGACY_REAL"
    if ! chattr -i "$LEGACY_REAL" 2>"$DEVNULL"; then
        log "older original had no immutable flag to clear"
    fi
    rb="$BASH_PATH.restore.$$"
    cp "$LEGACY_REAL" "$rb"
    chown root:root "$rb"
    chmod 0755 "$rb"
    mv -T "$rb" "$BASH_PATH"
else
    die "cannot restore stock bash: no diversion and no sealed or older original"
fi

# 3. Remove the sealed tree and the apt hook.
rm -f "$REAL_PATH" "$DISTRIB_PATH" "$LEGACY_REAL" "$LEGACY_DISTRIB"
rmdir "$SEALED_PKG_DIR" 2>"$DEVNULL" || log "sealed package dir not empty (left in place)"
rmdir "$SEALED_DIR" 2>"$DEVNULL" || log "sealed dir not empty (left in place)"
[ ! -e "$APT_HOOK" ] || { rm -f "$APT_HOOK"; log "removed apt hook"; }
[ ! -e "$APT_CHECK" ] || { rm -f "$APT_CHECK"; log "removed apt hook checker"; }

# 4. /bin/sh coverage.
if [ -e "$SEALED_PKG_DIR/sh" ] || [ -e "$SHG_ROOT/bin/sh.distrib" ]; then
    log "restoring /bin/sh"
    dpkg-divert --remove --rename "$SHG_ROOT/bin/sh" 2>"$DEVNULL" \
        || mv -T "$SEALED_PKG_DIR/sh" "$SHG_ROOT/bin/sh" 2>"$DEVNULL" \
        || mv -T "$SHG_ROOT/bin/sh.distrib" "$SHG_ROOT/bin/sh"
fi

# 5. Verify the restored shell.
[ -x "$BASH_PATH" ] || die "post-check: $BASH_PATH missing after restore"
"$BASH_PATH" --version > "$DEVNULL" || die "post-check: bash --version failed"
if [ -z "$SHG_ROOT" ]; then
    [ "$("$BASH_PATH" -c 'echo sh-ok')" = "sh-ok" ] || die "post-check: bash -c failed"
    [ "$(/bin/sh -c 'echo sh-ok')" = "sh-ok" ] || die "post-check: sh -c failed"
fi

log "shell guard removed; stock bash restored"
