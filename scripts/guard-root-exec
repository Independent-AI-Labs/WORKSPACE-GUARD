#!/usr/bin/env bash
# guard-root-exec: run a repository root script from the trusted tier.
#
# The shell guard classifies an untrusted script body by scanning it. A root
# installer that must strip an immutable flag cannot be run straight from the
# agent-owned checkout. This helper copies the reviewed script into the
# root-owned /var/lib/workspace-guard tree (trusted tier) and execs it there,
# so the guard classifies it trusted and does not scan the body.
#
# The staged runner lives at <STAGE_DIR>/scripts/<name>, so the conventional
# "$SCRIPT_DIR/.." resolves to <STAGE_DIR>. Every other top-level entry of the
# real checkout (.git, res, config, docs, target, ...) plus scripts/lib is
# symlinked into <STAGE_DIR>, so a staged script still reads and writes the
# live repository paths; SHG_SCRIPT_PATH cannot carry this because the guard
# strips it for trusted scripts and republishes it only when it stages one.
#
# Root only. The script name is preserved for its own basename checks.
#
# Usage: guard-root-exec <script> [args...]

set -euo pipefail

if [ "$(id -u)" != "0" ]; then
    echo "ERROR: guard-root-exec needs root: sudo make <target>" >&2
    exit 2
fi
if [ "$#" -lt 1 ]; then
    echo "ERROR: guard-root-exec: missing script argument" >&2
    exit 2
fi

SCRIPT="$1"
shift
[ -f "$SCRIPT" ] || { echo "ERROR: guard-root-exec: no such script: $SCRIPT" >&2; exit 2; }
SCRIPT_ABS="$(cd "$(dirname "$SCRIPT")" && pwd)/$(basename "$SCRIPT")"
REPO_DIR="$(cd "$(dirname "$SCRIPT_ABS")/.." && pwd)"

# Staged scripts exec from the /var mirror, so "$SCRIPT_DIR/.." resolves to
# /var rather than the real checkout. Publish the real checkout root so a
# staged installer derives the workspace root (its parent's parent) instead
# of recording "/var". Honours an explicit caller value when present.
export WORKSPACE_GUARD_ROOT="${WORKSPACE_GUARD_ROOT:-$REPO_DIR}"

STAGE_DIR=/var/lib/workspace-guard
SCRIPTS_DIR="$STAGE_DIR/scripts"
install -d -m 0700 -o root -g root "$STAGE_DIR" "$SCRIPTS_DIR"

# Mirror the checkout root (except scripts/, which stays a real trusted dir
# holding the staged runner) so repo-relative paths resolve to the real tree.
shopt -s nullglob
for entry in "$REPO_DIR"/* "$REPO_DIR"/.[!.]*; do
    base="$(basename "$entry")"
    [ "$base" = scripts ] && continue
    ln -sfn "$entry" "$STAGE_DIR/$base"
done
shopt -u nullglob
ln -sfn "$REPO_DIR/scripts/lib" "$SCRIPTS_DIR/lib"

STAGE="$SCRIPTS_DIR/$(basename "$SCRIPT_ABS")"
install -m 0700 -o root -g root "$SCRIPT_ABS" "$STAGE"

exec "$STAGE" "$@"