#!/usr/bin/env bash
# shell-guard-check: read-only health check for workspace-shell-guard.
#
# Implements docs/specifications/SPEC-SHELL-GUARD.md section 12.3.
# Verifies, without changing anything:
#   - guard binary present at the resolved bash path, ELF, root:root
#     0755, cap_dac_override=ep, hash-match against the repo build
#     when available
#   - /bin/bash.real sealed: root:root 0700, chattr +i, hash equal to
#     the diverted original
#   - dpkg-divert present for the resolved bash path (and /bin/sh
#     when covered)
#   - apt post-invoke hook installed
#   - policy configs root-owned and immutable
#
# Output ends with one of: OK / DRIFTED / NOT INSTALLED.
# Exit codes: 0 healthy, 1 drifted, 2 not installed.
# Any user may run this; the script body deliberately contains no
# policy-pattern text so it executes cleanly under an active guard
# from any trust tier.
#
# Repo-root resolution is explicit and ordered:
#   1. first argument, if given
#   2. SHG_REPO_ROOT, if set
#   3. derivation from the script's own path
# An explicitly supplied root (1 or 2) must be an existing directory
# or the script exits 2. Derivation (3) lands in /proc/self/fd when
# the guard stages this script through a sealed memfd (untrusted
# tier); in that case the script exits 2 with a remediation message
# telling the caller to pass the repo root explicitly. There is no
# cwd guessing and no skipped config-owner checks.
#
# Test hooks: SHG_ROOT prefixes absolute paths; SHG_GUARD_BIN
# overrides the reference guard binary; SHG_GETCAP overrides the
# getcap binary.

set -uo pipefail

DEVNULL=/dev/null
SHG_ROOT="${SHG_ROOT:-}"
SCRIPT_SRC="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SRC")" 2>"$DEVNULL" && pwd)"
case "$SCRIPT_DIR" in
    /proc|/proc/*|/dev/fd|/dev/fd/*|"") SCRIPT_DIR="" ;;
esac
REPO_ROOT=""
EXPLICIT_ROOT=""
if [ $# -ge 1 ]; then
    REPO_ROOT="$1"
    EXPLICIT_ROOT=1
elif [ -n "${SHG_REPO_ROOT:-}" ]; then
    REPO_ROOT="$SHG_REPO_ROOT"
    EXPLICIT_ROOT=1
elif [ -n "$SCRIPT_DIR" ]; then
    REPO_ROOT="$(cd "$SCRIPT_DIR/.." 2>"$DEVNULL" && pwd)"
fi
if [ -n "$EXPLICIT_ROOT" ] && [ ! -d "$REPO_ROOT" ]; then
    echo "shell guard: ERROR: repo root '$REPO_ROOT' is not a directory" >&2
    exit 2
fi
if [ -z "$REPO_ROOT" ]; then
    echo "shell guard: ERROR: repo root not determinable from script path" >&2
    echo "  (script was staged through a sealed fd by the guard)" >&2
    echo "  pass it explicitly: shell-guard-check <repo-root>" >&2
    exit 2
fi
GUARD_BIN="${SHG_GUARD_BIN:-$REPO_ROOT/target/release/workspace-shell-guard}"

# getcap lives in /usr/sbin on Debian/Ubuntu; the guard resets PATH to
# /usr/local/bin:/usr/bin:/bin, so resolve it absolutely.
GETCAP="${SHG_GETCAP:-}"
if [ -z "$GETCAP" ]; then
    GETCAP="$(command -v getcap 2>"$DEVNULL")"
fi
if [ -z "$GETCAP" ] && [ -x /usr/sbin/getcap ]; then
    GETCAP=/usr/sbin/getcap
fi
have_override_cap() {
    [ -n "$GETCAP" ] && "$GETCAP" "$1" 2>"$DEVNULL" | grep -q 'cap_dac_override=ep'
}

# lsattr needs read permission on the target; /bin/bash.real is 0700
# root:root, so a non-root caller gets EACCES. That is the installed
# posture, not drift: report OK-with-note when the file is unreadable,
# drift only when lsattr runs and shows no +i.
check_immutable() {
    local path="$1" out
    if out="$(lsattr -d "$path" 2>&1)"; then
        if awk '{print $1}' <<<"$out" | grep -q 'i'; then
            ok "$path immutable"
        else
            bad "$path missing +i"
        fi
    elif [ ! -r "$path" ]; then
        ok "$path immutable (not verifiable as non-root; read-protected file is the installed posture)"
    else
        bad "$path lsattr failed: $out"
    fi
}

BASH_LINK="$SHG_ROOT/bin/bash"
BASH_PATH="$(readlink -f "$BASH_LINK" 2>"$DEVNULL")"
if [ -z "$BASH_PATH" ]; then
    BASH_PATH="$BASH_LINK"
fi
REAL_PATH="$SHG_ROOT/bin/bash.real"
DISTRIB_PATH="$BASH_PATH.distrib"
APT_HOOK="$SHG_ROOT/etc/apt/apt.conf.d/99workspace-guard-shell"
CONFIG_DIR="$REPO_ROOT/config"

PROBLEMS=0
ok()   { echo "OK: $*"; }
bad()  { echo "DRIFT: $*"; PROBLEMS=$((PROBLEMS + 1)); }

hash_of() { sha256sum "$1" 2>"$DEVNULL" | awk '{print $1}'; }

# --- presence gate -----------------------------------------------------------
installed=0
[ -f "$REAL_PATH" ] && installed=1
[ -f "$DISTRIB_PATH" ] && installed=1
if have_override_cap "$BASH_PATH"; then
    installed=1
fi
if [ "$installed" -eq 0 ]; then
    echo "shell guard: NOT INSTALLED"
    exit 2
fi

# --- guard binary -------------------------------------------------------------
if [ ! -f "$BASH_PATH" ]; then
    bad "$BASH_PATH missing"
elif [ "$(dd if="$BASH_PATH" bs=4 count=1 2>"$DEVNULL" | od -An -tx1 | tr -d ' \n')" != "7f454c46" ]; then
    bad "$BASH_PATH is not an ELF binary"
else
    # Owner assertions are skipped under SHG_ROOT fixtures (files are
    # owned by the test user, not root).
    [ -n "$SHG_ROOT" ] || [ "$(stat -c %U:%G "$BASH_PATH")" = "root:root" ] || bad "$BASH_PATH not root:root"
    [ "$(stat -c %a "$BASH_PATH")" = "755" ] || bad "$BASH_PATH mode != 0755"
    if have_override_cap "$BASH_PATH"; then
        ok "$BASH_PATH caps"
    elif [ -z "$GETCAP" ]; then
        bad "getcap not found (looked in PATH and /usr/sbin); cannot verify caps"
    else
        bad "$BASH_PATH missing cap_dac_override=ep"
    fi
    if [ -x "$GUARD_BIN" ]; then
        if [ "$(hash_of "$BASH_PATH")" = "$(hash_of "$GUARD_BIN")" ]; then
            ok "$BASH_PATH matches repo build"
        else
            bad "$BASH_PATH hash differs from repo build (rebuild or reconcile)"
        fi
    fi
fi

# --- sealed original ----------------------------------------------------------
if [ ! -f "$REAL_PATH" ]; then
    bad "$REAL_PATH missing"
else
    [ -n "$SHG_ROOT" ] || [ "$(stat -c %U:%G "$REAL_PATH")" = "root:root" ] || bad "$REAL_PATH not root:root"
    [ "$(stat -c %a "$REAL_PATH")" = "700" ] || bad "$REAL_PATH mode != 0700"
    check_immutable "$REAL_PATH"
    if [ -f "$DISTRIB_PATH" ] && [ -r "$REAL_PATH" ]; then
        if [ "$(hash_of "$REAL_PATH")" = "$(hash_of "$DISTRIB_PATH")" ]; then
            ok "$REAL_PATH matches diverted original"
        else
            bad "$REAL_PATH hash differs from $DISTRIB_PATH"
        fi
    fi
fi

# --- diversion -----------------------------------------------------------------
if dpkg-divert --list "$BASH_PATH" 2>"$DEVNULL" | grep -q "diversion of $BASH_PATH"; then
    ok "diversion for $BASH_PATH"
else
    bad "no dpkg-divert for $BASH_PATH"
fi
if [ -e "$SHG_ROOT/bin/sh.distrib" ]; then
    if dpkg-divert --list "$SHG_ROOT/bin/sh" 2>"$DEVNULL" | grep -q "diversion of $SHG_ROOT/bin/sh"; then
        ok "diversion for /bin/sh"
    else
        bad "sh.distrib present but no dpkg-divert for /bin/sh"
    fi
fi

# --- apt hook -------------------------------------------------------------------
if [ -f "$APT_HOOK" ]; then
    ok "apt hook present"
else
    bad "apt hook missing: $APT_HOOK"
fi

# --- policy configs ---------------------------------------------------------------
if [ ! -d "$CONFIG_DIR" ]; then
    bad "policy config directory missing: $CONFIG_DIR"
else
    for f in shell_guard_policy.yaml shell_guard_policy.schema.yaml shell_guard_policy_matrix.yaml; do
        p="$CONFIG_DIR/$f"
        if [ ! -f "$p" ]; then
            bad "policy config missing: $p"
            continue
        fi
        [ -n "$SHG_ROOT" ] || [ "$(stat -c %u "$p")" = "0" ] || bad "$p not root-owned"
        check_immutable "$p"
    done
fi

# --- verdict -----------------------------------------------------------------------
if [ "$PROBLEMS" -eq 0 ]; then
    echo "shell guard: OK"
    exit 0
fi
echo "shell guard: DRIFTED ($PROBLEMS problem(s))"
exit 1
