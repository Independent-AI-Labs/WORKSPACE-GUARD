# config/systemd/workspace-exec-policyd.service
#
# Boot-time loader for the exec lane of the exclusive execution posture
# (REQ-EXEC-113, REQ-EXEC-116). It attaches the BPF LSM program to
# bprm_check_security, seeds the pinned allowlist map from
# /etc/workspace-guard/exec_allowlist.yaml, and writes the loader token
# only after BPF_LINK_CREATE succeeds. The loader owns the exec lane and
# nothing else: mount, signal, socket, ptrace, capability and kernel-code
# decisions belong to their single owners (REQ-EXEC-121 series).
#
# The session gate requires the full readiness manifest, which
# `make enable-exec-policy CONFIRM=1` writes only after every owner is
# verified. Before that the agent session does not start (fail closed).
#
# Installed by: sudo make install-exec-policy
# See docs/specifications/SPEC-EXEC-POLICY.md section 9.

[Unit]
Description=WORKSPACE-GUARD exclusive execution policy loader
After=local-fs.target
Before=workspace-agent@.service multi-user.target
ConditionPathExists=/usr/local/bin/workspace-exec-policyd
ConditionPathExists=/usr/local/lib/workspace-guard/exec_policy.bpf.o
ConditionPathExists=/etc/workspace-guard/exec_allowlist.yaml

[Service]
Type=notify
ExecStart=/usr/local/bin/workspace-exec-policyd \
    --object /usr/local/lib/workspace-guard/exec_policy.bpf.o \
    --policy /etc/workspace-guard/exec_allowlist.yaml \
    --bpf-ready /run/workspace-exec-policy/bpf-ready
Restart=on-failure
RestartSec=2s
CapabilityBoundingSet=CAP_BPF CAP_SYS_ADMIN CAP_PERFMON
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LockPersonality=yes
NoNewPrivileges=no
RuntimeDirectory=workspace-exec-policy
RuntimeDirectoryMode=0755
ReadWritePaths=/run/workspace-exec-policy

[Install]
WantedBy=multi-user.target
