# config/systemd/workspace-exec-policy.apparmor
#
# Exclusive-execution-posture confinement profile (REQ-EXEC-120 series),
# source for /etc/apparmor.d/workspace-exec-policy. Installed by
# `make install-exec-policy` and loaded in enforcing mode; this profile
# has no complain state.
#
# Lane contract (SPEC-EXEC-POLICY section 3): this profile owns the
# filesystem lane and the kernel-effect lane. Every other lane has one
# owner and this profile defers to it:
#   exec         -> eBPF LSM bprm_check_security   (here: /** ix)
#   ptrace       -> YAMA ptrace_scope=2            (here: allow)
#   capabilities -> capability LSM + agent unit    (here: allow)
#   kernel code  -> Lockdown integrity mode        (here: allow)
#   policy rules -> shell guard content contract   (not a kernel lane)
#
# Anything in the two owned lanes that is not granted below is denied.

#include <tunables/global>

profile workspace-exec-policy {
  # Exec lane: defer to the eBPF LSM authority. Granting ix for every
  # path means this profile never makes an execution decision.
  /** ix,

  # ptrace lane: owned by YAMA. Allow so this profile is not a second
  # ptrace decider.
  ptrace,

  # Capability lane: owned by the capability LSM and the agent unit's
  # bounding set. Allow so this profile is not a second decider.
  capability,

  # Filesystem lane: this profile is the sole filesystem authorizer.
  # Reviewed scaffold: broad read, map, lock and write access, with
  # explicit write denies for guard-owned policy and audit state. A
  # deployment review may tighten the grants to a path allow-list.
  /** rwkml,

  deny /etc/workspace-guard/** w,
  deny /var/log/workspace-guard/** w,
  deny /etc/apparmor.d/** w,
  deny /etc/systemd/system/** w,

  # Effects lane: this profile owns mount, signal and socket-family
  # decisions.
  deny mount,
  signal peer=workspace-exec-policy,
  deny network alg,
  deny network raw,
  deny network packet,
}
